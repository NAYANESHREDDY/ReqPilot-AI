# Copy to .env for local development. Never commit or share .env.
# Multi-key Groq pool (comma-separated, approximately 15+ keys supported).
# Precedence: GROQ_API_KEYS takes precedence and pools all keys. If only GROQ_API_KEY is set, single-key mode is used.
GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
JWT_SECRET=
DATABASE_URL=
