from typing import List, Dict, Any
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

class DuplicateAgent:
    """Agent 8.7: Duplicate & Overlap Detection Agent
    Calculates semantic and lexical similarity to identify redundant or overlapping requirements.
    Uses hybrid TF-IDF cosine similarity and token set Jaccard overlap.
    """

    def detect_duplicates(self, requirements: List[Dict[str, Any]], threshold: float = 0.65) -> List[Dict[str, Any]]:
        if len(requirements) < 2:
            return []

        corpus = [f"{r.get('summary', '')} {r.get('description', '')}" for r in requirements]
        vectorizer = TfidfVectorizer(stop_words="english")
        try:
            tfidf_matrix = vectorizer.fit_transform(corpus)
            sim_matrix = cosine_similarity(tfidf_matrix, tfidf_matrix)
        except Exception:
            sim_matrix = [[0.0] * len(requirements) for _ in range(len(requirements))]

        duplicates = []
        n = len(requirements)
        for i in range(n):
            for j in range(i + 1, n):
                score_tfidf = float(sim_matrix[i][j])
                
                # Token Jaccard overlap
                tokens_a = set(corpus[i].lower().split())
                tokens_b = set(corpus[j].lower().split())
                jaccard = len(tokens_a & tokens_b) / len(tokens_a | tokens_b) if (tokens_a | tokens_b) else 0.0
                
                effective_score = max(score_tfidf, jaccard)

                if effective_score >= threshold:
                    req_a = requirements[i]
                    req_b = requirements[j]
                    duplicates.append({
                        "requirement_id": req_a["id"],
                        "conflict_with_id": req_b["id"],
                        "issue_type": "duplicate",
                        "title": f"Near-Duplicate Requirement: {req_a['id']} & {req_b['id']}",
                        "description": f"Requirements {req_a['id']} and {req_b['id']} have a semantic overlap of {int(effective_score * 100)}%. Consider merging them.",
                        "detected_phrase": f"Similarity: {round(effective_score, 2)}",
                        "severity": "low",
                        "confidence": float(effective_score),
                    })

        return duplicates
