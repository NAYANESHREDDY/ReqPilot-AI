    # Phrases that are useful for understanding a requirement,
    # but should not become independent architecture modules.
    ENTITY_ALIASES = {
        "products": "product catalog",
        "product": "product catalog",
        "product catalog": "product catalog",
        "shopping cart": "cart",
        "carts": "cart",
        "orders": "order",
        "order": "order",
        "payments": "payment",
        "payment": "payment",
        "notifications": "notification",
        "notification": "notification",
        "attendance records": "attendance",
        "attendance record": "attendance",
        "attendance": "attendance",
        "users": "user management",
        "user": "user management",
        "students": "student management",
        "student": "student management",
        "faculty": "faculty management",
        "teachers": "faculty management",
        "teacher": "faculty management",
    }

    KNOWN_CAPABILITY_KEYS = {
        rule["key"] for rule in CAPABILITY_RULES
    }

    def generate_architecture(
        self,
        requirements: List[Dict[str, Any]],
        project_title: str,
    ) -> Dict[str, Any]:

        normalized = self._normalize_requirements(requirements)

        modules: List[Dict[str, Any]] = []
        used_capabilities = set()

        # ------------------------------------------------------------
        # 1. Detect reusable software capabilities.
        # ------------------------------------------------------------
        for rule in self.CAPABILITY_RULES:
            matches = self._matching_requirements(
                normalized,
                rule["patterns"],
            )

            if not matches:
                continue

            modules.append(
                self._build_rule_module(
                    rule,
                    matches,
                )
            )

            used_capabilities.add(rule["key"])

        # ------------------------------------------------------------
        # 2. Detect genuine domain entities from structured fields.
        # ------------------------------------------------------------
        generic_candidates = self._discover_domain_entities(
            normalized,
            used_capabilities,
        )

        for candidate in generic_candidates:
            modules.append(
                self._build_domain_module(candidate)
            )

        # ------------------------------------------------------------
        # 3. Persistence layer.
        # ------------------------------------------------------------
        modules.append(
            self._build_data_module()
        )

        # ------------------------------------------------------------
        # 4. Gateway only when there are multiple application services.
        # ------------------------------------------------------------
        services = [
            module
            for module in modules
            if module["module_type"] == "service"
        ]

        gateway_id: Optional[str] = None

        if len(services) >= 2:
            gateway_id = "MOD-GATEWAY"

            modules.insert(
                0,
                {
                    "id": gateway_id,
                    "name": "API Gateway",
                    "description": (
                        "Provides a common entry point for the "
                        "application services derived from the "
                        "software requirements."
                    ),
                    "module_type": "gateway",
                    "tech_stack": "API gateway / reverse proxy",
                    "responsibilities": [
                        "Route API requests",
                        "Apply common request controls",
                    ],
                    "api_endpoints": ["/api/*"],
                    "pos_x": 400.0,
                    "pos_y": 50.0,
                    "is_ai_suggested": True,
                    "status": "approved",
                },
            )

        self._assign_positions(modules)

        relations = self._generate_relations(
            modules,
            gateway_id,
        )

        return {
            "modules": modules,
            "relations": relations,
        }

    # ================================================================
    # Normalization
    # ================================================================

    @staticmethod
    def _normalize_requirements(
        requirements: List[Dict[str, Any]],
    ) -> List[Dict[str, Any]]:

        result = []

        for req in requirements:
            fields = [
                req.get("summary"),
                req.get("description"),
                req.get("actor"),
                req.get("action"),
                req.get("target_object"),
                req.get("expected_outcome"),
                req.get("acceptance_criteria"),
            ]

            text = " ".join(
                str(value)
                for value in fields
                if value is not None
            )

            text = re.sub(r"\s+", " ", text).strip()

            result.append(
                {
                    "id": req.get("id"),
                    "text": text,
                    "original": req,
                }
            )

        return result

    @staticmethod
    def _matching_requirements(
        requirements: List[Dict[str, Any]],
        patterns: List[str],
    ) -> List[Dict[str, Any]]:

        matches = []

        for req in requirements:
            if any(
                re.search(
                    pattern,
                    req["text"],
                    re.IGNORECASE,
                )
                for pattern in patterns
            ):
                matches.append(req)

        return matches

    # ================================================================
    # Known capability module
    # ================================================================

    def _build_rule_module(
        self,
        rule: Dict[str, Any],
        matches: List[Dict[str, Any]],
    ) -> Dict[str, Any]:

        evidence = [
            str(match["id"])
            for match in matches
            if match.get("id")
        ]

        description = (
            f"Handles capabilities related to "
            f"{rule['name'].lower()}."
        )

        if evidence:
            description += (
                " Supported by requirement evidence: "
                + ", ".join(evidence[:8])
                + "."
            )

        responsibilities = list(
            rule["responsibilities"]
        )

        return {
            "id": self._module_id(rule["key"]),
            "name": rule["name"],
            "description": description,
            "module_type": "service",
            "tech_stack": (
                "Application API + relational data access"
            ),
            "responsibilities": responsibilities,
            "api_endpoints": list(rule["endpoints"]),
            "pos_x": 150.0,
            "pos_y": 180.0,
            "is_ai_suggested": True,
            "status": "approved",
        }

    # ================================================================
    # Generic domain discovery
    # ================================================================

    def _discover_domain_entities(
        self,
        requirements: List[Dict[str, Any]],
        used_capabilities: set,
    ) -> List[Dict[str, Any]]:

        candidates: Dict[str, Dict[str, Any]] = {}

        for req in requirements:
            original = req["original"]

            raw_targets = [
                original.get("target_object"),
            ]

            # Also use the noun-like object explicitly mentioned in
            # simple structured action phrases, but never parse arbitrary
            # free text into long noun phrases.
            action = str(
                original.get("action") or ""
            ).strip()

            if action:
                target_from_action = self._target_after_action(
                    action
                )

                if target_from_action:
                    raw_targets.append(
                        target_from_action
                    )

            for raw_target in raw_targets:
                concept = self._clean_target(
                    raw_target
                )

                if not concept:
                    continue

                canonical = self._canonical_entity(
                    concept
                )

                if not canonical:
                    continue

                capability_key = self._entity_to_capability(
                    canonical
                )

                if capability_key in used_capabilities:
                    continue

                if self._should_ignore_entity(canonical):
                    continue

                key = self._concept_key(canonical)

                entry = candidates.setdefault(
                    key,
                    {
                        "key": key,
                        "concept": canonical,
                        "requirements": [],
                    },
                )

                if req not in entry["requirements"]:
                    entry["requirements"].append(req)

        ranked = sorted(
            candidates.values(),
            key=lambda item: (
                len(item["requirements"]),
                -len(item["concept"]),
            ),
            reverse=True,
        )

        return ranked[:8]

    @staticmethod
    def _target_after_action(
        action: str,
    ) -> Optional[str]:

        # Only handle very simple action structures.
        match = re.match(
            r"^(?:search|manage|create|update|delete|view|"
            r"retrieve|record|store|display|track|maintain)"
            r"\s+(.+)$",
            action,
            re.IGNORECASE,
        )

        if match:
            return match.group(1)

        return None

    def _clean_target(
        self,
        target: Any,
    ) -> Optional[str]:

        if target is None:
            return None

        value = str(target).strip().lower()

        if not value:
            return None

        # Remove requirement-language prefixes.
        value = re.sub(
            r"^(the|a|an|their|his|her|our|your)\s+",
            "",
            value,
        )

        # Remove trailing grammatical clauses.
        value = re.sub(
            r"\s+(are|is|was|were|for|from|with|by|in|on|at|"
            r"to|of|and|or|that|which|who)\s+.*$",
            "",
            value,
        )

        # Remove punctuation.
        value = re.sub(
            r"[.,;:!?()\[\]{}]",
            "",
            value,
        )

        value = re.sub(
            r"\s+",
            " ",
            value,
        ).strip()

        # Reject sentence-like targets.
        words = value.split()

        if len(words) > 4:
            return None

        if any(
            word in self.STOPWORDS
            for word in words
        ):
            # A valid compound like "product catalog" is fine.
            meaningful = [
                word
                for word in words
                if word not in self.STOPWORDS
            ]

            if not meaningful:
                return None

            if len(words) > 2:
                value = " ".join(meaningful)

        return value

    def _canonical_entity(
        self,
        concept: str,
    ) -> Optional[str]:

        if concept in self.ENTITY_ALIASES:
            return self.ENTITY_ALIASES[concept]

        # Singularize basic plural forms.
        words = concept.split()

        normalized = []

        for word in words:
            if word.endswith("ies") and len(word) > 4:
                word = word[:-3] + "y"
            elif word.endswith("s") and len(word) > 3:
                word = word[:-1]

            normalized.append(word)

        concept = " ".join(normalized)

        if concept in self.ENTITY_ALIASES:
            return self.ENTITY_ALIASES[concept]

        return concept

    def _entity_to_capability(
        self,
        entity: str,
    ) -> Optional[str]:

        mapping = {
            "product catalog": "search",
            "cart": "cart",
            "order": "order",
            "payment": "payment",
            "notification": "notification",
            "attendance": "attendance",
            "user management": "profile",
        }

        return mapping.get(entity)

    def _should_ignore_entity(
        self,
        entity: str,
    ) -> bool:

        words = set(entity.split())

        if not words:
            return True

        if words.issubset(self.STOPWORDS):
            return True

        if len(entity.split()) > 4:
            return True

        return False

    @staticmethod
    def _concept_key(
        concept: str,
    ) -> str:

        return re.sub(
            r"[^a-z0-9]+",
            "-",
            concept.lower(),
        ).strip("-")

    # ================================================================
    # Generic domain module
    # ================================================================

    def _build_domain_module(
        self,
        candidate: Dict[str, Any],
    ) -> Dict[str, Any]:

        concept = candidate["concept"]
        evidence = [
            str(req["id"])
            for req in candidate["requirements"]
            if req.get("id")
        ]

        slug = self._concept_key(concept)

        responsibilities = [
            f"Manage {concept}",
            f"Provide operations related to {concept}",
        ]

        description = (
            f"Provides application capabilities for "
            f"{concept} identified from the requirements."
        )

        if evidence:
            description += (
                " Supported by requirement evidence: "
                + ", ".join(evidence[:8])
                + "."
            )

        return {
            "id": self._module_id(
                f"domain-{slug}"
            ),
            "name": self._title_case(concept),
            "description": description,
            "module_type": "service",
            "tech_stack": (
                "Application API + relational data access"
            ),
            "responsibilities": responsibilities,
            "api_endpoints": [
                f"/api/{slug}",
                f"/api/{slug}/{{id}}",
            ],
            "pos_x": 150.0,
            "pos_y": 180.0,
            "is_ai_suggested": True,
            "status": "approved",
        }

    # ================================================================
    # Data layer
    # ================================================================

    @staticmethod
    def _build_data_module() -> Dict[str, Any]:

        return {
            "id": "MOD-DATA",
            "name": "Application Data Store",
            "description": (
                "Provides persistent storage for entities and records "
                "required by the analyzed software requirements."
            ),
            "module_type": "database",
            "tech_stack": "Relational database",
            "responsibilities": [
                "Persist application entities",
                "Maintain data consistency",
                "Support application data retrieval",
            ],
            "api_endpoints": [],
            "pos_x": 400.0,
            "pos_y": 500.0,
            "is_ai_suggested": True,
            "status": "approved",
        }

    # ================================================================
    # IDs / names
    # ================================================================

    @staticmethod
    def _module_id(
        value: str,
    ) -> str:

        safe = re.sub(
            r"[^A-Za-z0-9]+",
            "-",
            value,
        ).strip("-").upper()

        return f"MOD-{safe}"

    @staticmethod
    def _title_case(
        value: str,
    ) -> str:

        return " ".join(
            word.capitalize()
            for word in value.split()
        )

    # ================================================================
    # Layout
    # ================================================================

    @staticmethod
    def _assign_positions(
        modules: List[Dict[str, Any]],
    ) -> None:

        gateway = next(
            (
                module
                for module in modules
                if module["module_type"] == "gateway"
            ),
            None,
        )

        database = next(
            (
                module
                for module in modules
                if module["module_type"] == "database"
            ),
            None,
        )

        services = [
            module
            for module in modules
            if module["module_type"] == "service"
        ]

        if gateway:
            gateway["pos_x"] = 400.0
            gateway["pos_y"] = 50.0

        for index, module in enumerate(services):
            column = index % 3
            row = index // 3

            module["pos_x"] = (
                150.0 + column * 250.0
            )

            module["pos_y"] = (
                180.0 + row * 170.0
            )

        if database:
            database["pos_x"] = 400.0
            database["pos_y"] = 500.0

    # ================================================================
    # Conservative relations
    # ================================================================

    @staticmethod
    def _generate_relations(
        modules: List[Dict[str, Any]],
        gateway_id: Optional[str],
    ) -> List[Dict[str, Any]]:

        module_ids = {
            module["id"]
            for module in modules
        }

        services = [
            module["id"]
            for module in modules
            if module["module_type"] == "service"
        ]

        relations = []
        seen = set()

        def add(
            source: str,
            target: str,
            relation_type: str,
            description: str,
        ):
            if source not in module_ids:
                return

            if target not in module_ids:
                return

            if source == target:
                return

            key = (
                source,
                target,
                relation_type,
            )

            if key in seen:
                return

            seen.add(key)

            relations.append(
                {
                    "source_module_id": source,
                    "target_module_id": target,
                    "relation_type": relation_type,
                    "description": description,
                }
            )

        # Gateway -> services.
        if gateway_id:
            for service_id in services:
                add(
                    gateway_id,
                    service_id,
                    "calls",
                    "Route API requests to the service.",
                )

        # Every service uses persistence.
        for service_id in services:
            add(
                service_id,
                "MOD-DATA",
                "reads_from",
                "Persist and retrieve application data.",
            )

        # Authentication supports application services.
        if "MOD-AUTHENTICATION" in module_ids:
            for service_id in services:
                if service_id == "MOD-AUTHENTICATION":
                    continue

                add(
                    "MOD-AUTHENTICATION",
                    service_id,
                    "supports",
                    "Provide authentication and authorization "
                    "support to the application service.",
                )

        # Only capabilities with an explicit notification relationship
        # receive an event relation.
        notification_producers = {
            "MOD-ORDER",
            "MOD-PAYMENT",
            "MOD-BOOKING",
            "MOD-ATTENDANCE",
        }

        if "MOD-NOTIFICATION" in module_ids:
            for source_id in notification_producers:
                if source_id in module_ids:
                    add(
                        source_id,
                        "MOD-NOTIFICATION",
                        "publishes_to",
                        "Emit an application event that can trigger "
                        "a notification.",
                    )

        return relations